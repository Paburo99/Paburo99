# Publish only the profile, its renderable assets and the daily refresh runtime.
# Authoring scripts, fonts, source art, documents, dependencies and backups stay local.
/*
!/README.md
!/.gitignore
!/.github/
!/assets/

/.github/*
!/.github/update-activity.mjs
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/profile.yml

/assets/*
!/assets/studio.svg
!/assets/studio-static.svg
!/assets/intro.svg
!/assets/intro-mobile.svg
!/assets/nav-projects.svg
!/assets/nav-projects-mobile.svg
!/assets/nav-activity.svg
!/assets/nav-activity-mobile.svg
!/assets/nav-repos.svg
!/assets/nav-repos-mobile.svg
!/assets/projects-heading.svg
!/assets/sumika.svg
!/assets/sumika-mobile.svg
!/assets/influence-dealers.svg
!/assets/influence-dealers-mobile.svg
!/assets/activity.svg
!/assets/activity-mobile.svg
!/assets/footer.svg
!/assets/footer-mobile.svg
!/assets/screenshots/
/assets/screenshots/*
!/assets/screenshots/sumika-home.png
!/assets/screenshots/influence-dealers-home.png
